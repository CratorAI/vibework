{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "webviews": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "deep-link:default",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-set-badge-count"
  ]
}